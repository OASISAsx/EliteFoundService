generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model sessions {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  jwt     String
  user_id String @unique(map: "user_id_1")
}

model FileUpload {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  url String
}

model users {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  googleId           String?
  profileImage       String?
  email              String            @unique
  name               String
  password           String?
  status             String?
  usersInformationId String?
  usersInformation   usersInformation? @relation(fields: [usersInformationId], references: [id])
}

model usersInformation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String
  lastName      String
  citizenId     String   @unique
  dateOfBirth   DateTime
  gender        String?
  nationality   String?
  maritalStatus String?

  phone    String  @unique
  email    String?
  lineId   String?
  facebook String?

  currentAddress    String
  registeredAddress String?
  province          String
  district          String
  zipcode           String

  occupation     String
  companyName    String?
  companyAddress String?
  position       String?
  salaryPerMonth Float
  otherIncome    Float?  @default(0)
  workYears      Int
  employmentType String // fulltime freelance business

  bankName          String
  bankAccountName   String
  bankAccountNumber String

  monthlyExpense          Float
  existingDebt            Boolean @default(false)
  debtAmount              Float?  @default(0)
  debtInstallmentPerMonth Float?  @default(0)

  kycStatus   String  @default("pending")
  creditScore Int?
  riskLevel   String?

  loanStatus     String   @default("pending")
  id_card_image  String
  selfie_with_id String
  salary_slip    String
  bank_statement String
  house_document String
  other_files    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Users          users[]
  loanGuarantors LoanGuarantor[]
}

model LoanGuarantor {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  usersInformationId String

  name         String
  relationship String
  phone        String
  address      String

  createdAt DateTime @default(now())

  usersInformation usersInformation @relation(fields: [usersInformationId], references: [id])
}
