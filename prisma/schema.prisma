generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model sessions {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  jwt     String
  user_id String @unique(map: "user_id_1")
}

model FileUpload {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  url String
}

model Users {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  googleId           String? @unique
  profileImage       String?
  email              String  @unique
  name               String
  password           String?
  status             String?
  usersInformationId String? @db.ObjectId

  usersInformation UsersInformation? @relation(fields: [usersInformationId], references: [id])
}

model UsersInformation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String
  lastName      String
  citizenId     String   @unique
  dateOfBirth   DateTime
  gender        String?
  nationality   String?
  maritalStatus String?
  id_card_image String
  phone         String   @unique

  email    String?
  lineId   String?
  facebook String?

  currentAddress  String?
  provinceCode    Int?
  districtCode    Int?
  subdistrictCode Int?
  zipcode         String?

  loanStatus String @default("pending")

  other_files String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Users           Users[]
  loanGuarantors  LoanGuarantor[]
  JobDetail       JobDetail?
  bankInformation BankInformation?
  province        Province?        @relation(fields: [provinceCode], references: [code])
  district        District?        @relation(fields: [districtCode], references: [code])
  subdistrict     Subdistrict?     @relation(fields: [subdistrictCode], references: [code])
}

model JobDetail {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  occupation         String
  companyName        String?
  companyAddress     String?
  position           String?
  salaryPerMonth     Float
  otherIncome        Float?    @default(0)
  workYears          Int
  employmentType     String // fulltime freelance business
  salarySlip         String[]
  startDate          DateTime?
  usersInformationId String    @unique @db.ObjectId

  usersInformation UsersInformation @relation(fields: [usersInformationId], references: [id])
}

model BankInformation {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  bankName          String
  bankAccountName   String
  bankAccountNumber String

  monthlyExpense          Float
  existingDebt            Boolean @default(false)
  debtAmount              Float?  @default(0)
  debtInstallmentPerMonth Float?  @default(0)

  kycStatus      String   @default("pending")
  creditScore    Int?
  riskLevel      String?
  bank_statement String[]

  usersInformationId String @unique @db.ObjectId

  usersInformation UsersInformation @relation(fields: [usersInformationId], references: [id])
}

model LoanGuarantor {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  usersInformationId String @unique @db.ObjectId

  name         String
  relationship String
  phone        String
  address      String

  createdAt DateTime @default(now())

  usersInformation UsersInformation @relation(fields: [usersInformationId], references: [id])
}

// Aaddess
model Province {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  code   Int     @unique
  nameTh String
  nameEn String?

  districts         District[]
  subdistricts      Subdistrict[]      @relation("ProvinceSubdistrict")
  usersInformations UsersInformation[]
}

model District {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  code   Int     @unique
  nameTh String
  nameEn String?

  provinceCode Int
  province     Province @relation(fields: [provinceCode], references: [code])

  subdistricts      Subdistrict[]
  usersInformations UsersInformation[]
}

model Subdistrict {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  code       Int     @unique
  nameTh     String
  nameEn     String?
  postalCode String

  districtCode Int
  district     District @relation(fields: [districtCode], references: [code])

  provinceCode      Int
  province          Province           @relation("ProvinceSubdistrict", fields: [provinceCode], references: [code])
  usersInformations UsersInformation[]
}
